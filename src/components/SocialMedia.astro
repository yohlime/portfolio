---
import { socialMediaLinks } from '../data/portfolio'

const links = [
  { key: 'github', label: 'GitHub', bg: 'bg-[#333]', icon: 'i-fa6-brands-github', relMe: false },
  { key: 'linkedin', label: 'LinkedIn', bg: 'bg-[#0a66c2]', icon: 'i-fa6-brands-linkedin-in', relMe: false },
  { key: 'bluesky', label: 'Bluesky', bg: 'bg-[#0285ff]', icon: 'i-fa6-brands-bluesky', relMe: false },
  { key: 'xTwitter', label: 'X (Twitter)', bg: 'bg-[#000]', icon: 'i-fa6-brands-x-twitter', relMe: false },
  { key: 'mastodon', label: 'Mastodon', bg: 'bg-[#6364ff]', icon: 'i-fa6-brands-mastodon', relMe: true },
] as const

const items = links.map((link) => ({ ...link, href: socialMediaLinks[link.key] })).filter((link) => Boolean(link.href))
---

<div class="flex space-x-2 justify-center md:justify-start">
  {items.map(({ label, bg, icon, href, relMe }) => (
    <a
      href={href}
      aria-label={label}
      title={label}
      rel={relMe ? 'me noopener noreferrer' : 'noopener noreferrer'}
      target="_blank"
      class={`flex ${bg} w-10 h-10 justify-center items-center social-media-badge`}
    >
      <span class={`${icon} w-1/2 h-1/2 text-white`} aria-hidden="true" />
    </a>
  ))}
</div>

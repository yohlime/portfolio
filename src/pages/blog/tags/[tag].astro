---
import { getLiveCollection } from 'astro:content'
import { getSecret } from 'astro:env/server'

import BlogPostCard from '@/components/BlogPostCard.astro'
import DefaultLayout from '@/layouts/Default.astro'

export const prerender = false

const showDrafts = import.meta.env.DEV || getSecret('SHOW_DRAFTS') === 'true'
const tag = Astro.params.tag ?? ''

const { entries, error } = await getLiveCollection('blog')
if (error) {
  console.error('[blog] failed to load posts:', error)
}

const posts = (entries ?? [])
  .filter((entry) => (showDrafts || !entry.data.draft) && entry.data.tags.includes(tag))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: `/blog/${entry.data.slug.split('/').map(encodeURIComponent).join('/')}`,
    cover: entry.data.cover,
    coverAlt: entry.data.coverAlt ?? '',
    publishedAt: entry.data.date,
    minutesRead: entry.data.minutesRead,
    tags: entry.data.tags,
  }))

const openGraph = {
  title: `#${tag} posts - Emilio Gozo`,
  description: `Blog posts tagged "${tag}".`,
  type: 'article',
}
---

<DefaultLayout title={`#${tag} posts by Emilio Gozo`} openGraph={openGraph}>
  <div class="flex flex-wrap items-baseline gap-3">
    <h1 class="text-3xl md:text-5xl">#{tag}</h1>
    <a href="/blog/" class="text-sm text-subtitle transition-colors hover:text-button">
      ← All posts
    </a>
  </div>
  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.map((post) => (
      <BlogPostCard {...post} />
    ))}
  </ul>
  {posts.length === 0 && <p class="text-center text-gray-500">No posts with this tag.</p>}
</DefaultLayout>

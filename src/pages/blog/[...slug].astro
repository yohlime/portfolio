---
import { getLiveEntry } from 'astro:content'
import { getSecret } from 'astro:env/server'
import { formatDistanceToNow } from 'date-fns'

import Comment from '@/components/Comment.astro'
import DefaultLayout from '@/layouts/Default.astro'
import ShareButtons from '@/components/vue/ShareButtons.vue'
import { formatPostDateShort, formatPostTimestamp } from '@/lib/dates'
import { blogPostingGraph } from '@/lib/schema'

const showDrafts = import.meta.env.DEV || getSecret('SHOW_DRAFTS') === 'true'

const { slug } = Astro.params
const { entry, error } = await getLiveEntry('blog', slug ?? '')

if (error || !entry || (entry.data.draft && !showDrafts)) {
  return Astro.rewrite('/404')
}

const { data, rendered } = entry
const html = rendered?.html ?? ''
const wasUpdated = data.updated.getTime() > data.date.getTime()
const shareUrl = new URL(Astro.url.pathname, Astro.site).href
const cover = data.cover ? new URL(data.cover, Astro.site).href : undefined

const jsonLd = blogPostingGraph({
  url: shareUrl,
  title: data.title,
  description: data.description,
  image: cover,
  datePublished: data.date.toISOString(),
  dateModified: data.updated.toISOString(),
  tags: data.tags,
})
---

<DefaultLayout
  title={`${data.title} by Emilio Gozo`}
  jsonLd={jsonLd}
  openGraph={{
    title: data.title,
    description: data.description,
    image: data.cover,
    type: 'article',
    publishedTime: data.date.toISOString(),
    modifiedTime: data.updated.toISOString(),
  }}
>
  <article class="mx-auto max-w-none w-full md:w-2xl lg:w-4xl min-h-xl prose shadow-lg dark:prose-invert dark:shadow-sm dark:shadow-white p-8 rounded-xl">
    {data.cover && (
      <img
        class="w-full h-60 lg:h-80 object-cover"
        src={`${data.cover}?w=1200&format=webp`}
        width="900"
        height="400"
        alt={data.coverAlt ?? ''}
      />
    )}
    <h1>{data.title}</h1>

    <div class="not-prose flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <div class="flex flex-wrap gap-x-4 text-sm text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1">
          <span class="i-fa6-solid-calendar-day" aria-hidden="true" />
          <time datetime={data.date.toISOString()} title={formatPostTimestamp(data.date)}>
            {formatPostDateShort(data.date)}
          </time>
        </span>
        {wasUpdated && (
          <span class="flex items-center gap-1">
            <span class="i-fa6-solid-pencil" aria-hidden="true" />
            <time datetime={data.updated.toISOString()} title={formatPostTimestamp(data.updated)}>
              {formatDistanceToNow(data.updated, { addSuffix: true })}
            </time>
          </span>
        )}
        <span class="flex items-center gap-1">
          <span class="i-fa6-solid-clock" aria-hidden="true" />
          {data.minutesRead}
        </span>
      </div>
      <ShareButtons url={shareUrl} title={data.title} client:visible />
    </div>

    <Fragment set:html={html} />

    <Comment />
  </article>
</DefaultLayout>

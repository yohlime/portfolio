---
import { getLiveCollection } from 'astro:content'
import { formatDistance } from 'date-fns'

import DefaultLayout from '@/layouts/Default.astro'

const showDrafts = import.meta.env.DEV || process.env.SHOW_DRAFTS === 'true'

const { entries, error } = await getLiveCollection('blog')
if (error) {
  console.error('[blog] failed to load posts:', error)
}

const posts = (entries ?? [])
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    slug: entry.data.slug,
    href: `/blog/${entry.data.slug.split('/').map(encodeURIComponent).join('/')}`,
    cover: entry.data.cover,
    coverAlt: entry.data.coverAlt ?? '',
    publishedAt: entry.data.date,
  }))

const openGraphImg = '/cover-blogs.jpeg'
const openGraph = {
  title: 'Blog List - Emilio Gozo',
  description:
    'Explore our latest blog posts covering programming and data science, with a special focus on weather and climate topics. Stay informed and discover insights at the intersection of technology and environmental science.',
  type: 'article',
  image: openGraphImg,
}
---

<DefaultLayout title="Blog by Emilio Gozo" openGraph={openGraph}>
  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      posts.map(({ title, description, publishedAt, href, cover, coverAlt }) => (
        <a
          href={href}
          class="flex flex-col items-center md:flex-row md:max-w-lg bg-white border border-gray-200 rounded-lg shadow  hover:bg-gray-100 dark:border-gray-700 dark:bg-slate-900 dark:hover:shadow-sm dark:hover:shadow-white dark:hover:bg-button-hover transition-shadow duration-300 ease-in"
        >
          {cover && (
            <img
              class="object-cover rounded-t-lg w-full h-54 md:h-full md:w-48 md:min-h-48 md:rounded-none md:rounded-s-lg"
              src={`${cover}?w=400&h=400&format=webp`}
              width="200"
              height="200"
              loading="lazy"
              alt={coverAlt}
            />
          )}
          <div class="flex flex-col w-full justify-between p-4 leading-normal">
            <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{title}</h5>
            <p class="mb-3 font-normal text-gray-700 dark:text-gray-400 line-clamp-3">{description}</p>
            <span class="text-xs text-right text-gray-500 dark-text-gray-300">
              {formatDistance(publishedAt, new Date(), { addSuffix: true })}
            </span>
          </div>
        </a>
      ))
    }
  </ul>
  {posts.length === 0 && <p class="text-center text-gray-500">No posts yet.</p>}
</DefaultLayout>

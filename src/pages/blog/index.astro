---
import { getLiveCollection } from 'astro:content'
import { getSecret } from 'astro:env/server'

import BlogPostCard from '@/components/BlogPostCard.astro'
import DefaultLayout from '@/layouts/Default.astro'
import { tagHref } from '@/lib/tags'

const showDrafts = import.meta.env.DEV || getSecret('SHOW_DRAFTS') === 'true'

const { entries, error } = await getLiveCollection('blog')
if (error) {
  console.error('[blog] failed to load posts:', error)
}

const posts = (entries ?? [])
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: `/blog/${entry.data.slug.split('/').map(encodeURIComponent).join('/')}`,
    cover: entry.data.cover,
    coverAlt: entry.data.coverAlt ?? '',
    publishedAt: entry.data.date,
    minutesRead: entry.data.minutesRead,
    tags: entry.data.tags,
  }))

const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort()

const openGraphImg = '/cover-blogs.jpeg'
const openGraph = {
  title: 'Blog List - Emilio Gozo',
  description:
    'Explore our latest blog posts covering programming and data science, with a special focus on weather and climate topics. Stay informed and discover insights at the intersection of technology and environmental science.',
  type: 'article',
  image: openGraphImg,
}
---

<DefaultLayout title="Blog by Emilio Gozo" openGraph={openGraph}>
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-3xl md:text-5xl">Blog</h1>
    <a
      href="/rss.xml"
      aria-label="RSS feed"
      title="RSS feed"
      class="flex items-center gap-1.5 text-sm text-subtitle hover:text-button transition-colors"
    >
      <span class="i-fa6-solid-rss" aria-hidden="true" />
      RSS
    </a>
  </div>

  {allTags.length > 0 && (
    <ul class="flex flex-wrap gap-2 my-4">
      {allTags.map((tag) => (
        <li>
          <a
            href={tagHref(tag)}
            class="rounded-full bg-nav px-3 py-1 text-sm text-gray-600 transition-colors hover:bg-button hover:text-white dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-button-hover"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )}

  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.map((post) => (
      <BlogPostCard {...post} />
    ))}
  </ul>
  {posts.length === 0 && <p class="text-center text-gray-500">No posts yet.</p>}
</DefaultLayout>

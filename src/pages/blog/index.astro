---
import { getLiveCollection } from 'astro:content'
import { getSecret } from 'astro:env/server'
import { formatDistanceToNow } from 'date-fns'

import DefaultLayout from '@/layouts/Default.astro'
import { formatPostDate } from '@/lib/dates'

const showDrafts = import.meta.env.DEV || getSecret('SHOW_DRAFTS') === 'true'

const { entries, error } = await getLiveCollection('blog')
if (error) {
  console.error('[blog] failed to load posts:', error)
}

const posts = (entries ?? [])
  .filter((entry) => showDrafts || !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    slug: entry.data.slug,
    href: `/blog/${entry.data.slug.split('/').map(encodeURIComponent).join('/')}`,
    cover: entry.data.cover,
    coverAlt: entry.data.coverAlt ?? '',
    publishedAt: entry.data.date,
    minutesRead: entry.data.minutesRead,
  }))

const openGraphImg = '/cover-blogs.jpeg'
const openGraph = {
  title: 'Blog List - Emilio Gozo',
  description:
    'Explore our latest blog posts covering programming and data science, with a special focus on weather and climate topics. Stay informed and discover insights at the intersection of technology and environmental science.',
  type: 'article',
  image: openGraphImg,
}
---

<DefaultLayout title="Blog by Emilio Gozo" openGraph={openGraph}>
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-3xl md:text-5xl">Blog</h1>
    <a
      href="/rss.xml"
      aria-label="RSS feed"
      title="RSS feed"
      class="flex items-center gap-1.5 text-sm text-subtitle hover:text-button transition-colors"
    >
      <span class="i-fa6-solid-rss" aria-hidden="true" />
      RSS
    </a>
  </div>
  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.map(({ title, description, publishedAt, href, cover, coverAlt, minutesRead }) => (
      <a
        href={href}
        class="flex flex-col items-center md:flex-row md:max-w-lg bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:border-gray-700 dark:bg-slate-900 dark:hover:shadow-sm dark:hover:shadow-white dark:hover:bg-button-hover transition-shadow duration-300 ease-in"
      >
        {cover && (
          <img
            class="object-cover rounded-t-lg w-full h-54 md:h-full md:w-48 md:min-h-48 md:rounded-none md:rounded-s-lg"
            src={`${cover}?w=400&h=400&format=webp`}
            width="200"
            height="200"
            loading="lazy"
            alt={coverAlt}
          />
        )}
        <div class="flex flex-col w-full justify-between p-4 leading-normal">
          <h2 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{title}</h2>
          <p class="mb-3 font-normal text-gray-700 dark:text-gray-400 line-clamp-3">{description}</p>
          <div class="flex items-center justify-end gap-2 text-xs text-gray-500 dark-text-gray-300">
            <span class="flex items-center gap-1">
              <span class="i-fa6-solid-clock" aria-hidden="true" />
              {minutesRead}
            </span>
            <span aria-hidden="true">·</span>
            <span class="flex items-center gap-1">
              <span class="i-fa6-solid-calendar-day" aria-hidden="true" />
              <time datetime={publishedAt.toISOString()} title={formatPostDate(publishedAt)}>
                {formatDistanceToNow(publishedAt, { addSuffix: true })}
              </time>
            </span>
          </div>
        </div>
      </a>
    ))}
  </ul>
  {posts.length === 0 && <p class="text-center text-gray-500">No posts yet.</p>}
</DefaultLayout>
